[Unit]
Description=Gmail MCP scheduled email worker
Documentation=file:/opt/gmail-mcp/current/deploy/README.md
Wants=network-online.target
After=network-online.target gmail-mcp.service
ConditionPathExists=/var/lib/gmail-mcp-deploy/run-authorized.env
ConditionPathExists=!/var/lib/gmail-mcp-deploy/migration-fence.env

[Service]
Type=simple
User=gmail-mcp
Group=gmail-mcp
EnvironmentFile=/etc/gmail-mcp/gmail-mcp.env
WorkingDirectory=/opt/gmail-mcp/current
ExecStartPre=+/usr/bin/python3 -I /opt/gmail-mcp/current/deploy/lib/envfile.py validate --profile gmail --config-dir /etc/gmail-mcp --state-dir /var/lib/gmail-mcp --require-owner-uid 0 --require-mode 0600 --require-single-link /etc/gmail-mcp/gmail-mcp.env
ExecStart=/opt/gmail-mcp/current/deploy/bin/run-scheduler.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/gmail-mcp /opt/gmail-mcp
ReadWritePaths=/var/lib/gmail-mcp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

# Root-owned deployment settings. Copy to /etc/gmail-mcp/gmail-mcp.env.
# PUBLIC_ORIGIN is an origin only. Put any routing prefix in BASE_PATH.
PUBLIC_ORIGIN=https://mcp.example.com
BASE_PATH=
PORT=8080

# Generate with: openssl rand -hex 32
GMAIL_MCP_API_KEY=REPLACE_ME
GMAIL_MCP_OAUTH_CALLBACKS=https://claude.ai/api/mcp/auth_callback

# Google OAuth client JSON is provisioned separately with mode 0640.
GMAIL_OAUTH_PATH=/etc/gmail-mcp/gcp-oauth.keys.json
GMAIL_CREDENTIALS_PATH=/var/lib/gmail-mcp/credentials.json

# Optional fixed ngrok endpoint. Copy to /etc/gmail-mcp/ngrok.env.
NGROK_AUTHTOKEN=REPLACE_ME
NGROK_DOMAIN=replace-with-assigned-domain.ngrok-free.app

# Optional absolute path. The launcher otherwise resolves ngrok from PATH.
NGROK_BIN=

# Point directly at the app for BASE_PATH="". Point at the local Nginx listener
# when BASE_PATH is non-empty or this server participates in shared ingress.
NGROK_UPSTREAM=http://127.0.0.1:8080
